---
import type { CollectionEntry } from 'astro:content';

import FormattedDate from '../components/FormattedDate.astro';
import { getLocale } from '../paraglide/runtime.js';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { data, id } = Astro.props.post;
const locale = getLocale();
const imageSrc = data.img ?? '/blog-placeholder-1.jpg';
---

<a class="card" href={`/${locale}/blog/${id}/`}>
	<span class="media">
		<img src={imageSrc} alt={data.img_alt || ''} loading="lazy" decoding="async" />
	</span>
	<span class="body">
		<h4 class="title">{data.title}</h4>
		<span class="date">
			<FormattedDate date={data.publishDate} />
		</span>
	</span>
</a>

<style>
	.card {
		display: grid;
		grid-template-rows: auto 1fr;
		height: 100%;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		background: var(--gray-999);
		transition:
			border-color var(--theme-transition),
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.card:hover,
	.card:focus {
		border-color: var(--accent-regular);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.media {
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.body {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: 1rem;
		background: var(--gradient-subtle);
	}

	.title {
		margin: 0;
		color: var(--gray-100);
		font-size: clamp(1.15rem, 1rem + 0.45vw, 1.45rem);
		line-height: 1.15;
		letter-spacing: 0;
		overflow-wrap: anywhere;
	}

	.date {
		color: var(--gray-300);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.body {
			padding: 1.25rem;
		}
	}
</style>
