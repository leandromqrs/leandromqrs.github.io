---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import type { iconPaths } from './IconPaths';
import { m } from "../paraglide/messages.js";
import { getLocale } from '../paraglide/runtime.js';

const locale = getLocale();

/** Main menu items */
const textLinks: { label: string; href: string, className: string }[] = [
	{ label: m.navHome(), href: `/${locale}/`, className: 'link' },
	{ label: m.navWork(), href: `/${locale}/work/`, className: 'link' },
	{ label: m.navBlog(), href: `/${locale}/blog/`, className: 'link' },
	{ label: m.navAbout(), href: `/${locale}/about/`, className: 'link' },
	{ label: m.navBookACall(), href: `/${locale}/book-a-call/`, className: 'link call-to-action' },
];

/** Icon links to social media. Edit these with links to your profiles. */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/leandromqrs', icon: 'linkedin-logo' },
	{ label: 'GitHub', href: 'https://github.com/leandromqrs', icon: 'github-logo' },
	{ label: 'Twitter', href: 'https://twitter.com/leandromqrs', icon: 'twitter-logo' },
	{ label: 'Mastodon', href: 'https://mastodon.social/@leandromqrs', icon: 'mastodon-logo' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';

	// Exact match
	if (pathname === href) return true;

	// Special case for home page with language prefix
	if (href === `/${locale}/` && pathname === `/${locale}/`) return true;

	// Check if we're in a section (like /work/ or /blog/)
	// But avoid matching partial paths (like /work/ matching /worked/)
	if (href !== '/' && href !== `/${locale}/`) {
		// Extract the section from the URL (e.g., /en/work/ => work)
		const hrefParts = href.split('/').filter(Boolean);
		const pathnameParts = pathname.split('/').filter(Boolean);

		// If href has at least a language and section, and pathname has same parts
		if (hrefParts.length >= 2 && pathnameParts.length >= 2) {
			// Check if the language and section match
			return hrefParts[0] === pathnameParts[0] && hrefParts[1] === pathnameParts[1];
		}
	}

	return false;
};
---

<nav>
	<div class="menu-header">
		<a href="/" class="site-title">
			<span class="prompt" aria-hidden="true">~$</span>
			Leandro Rodrigues
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href, className }) => {
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class={className} href={href}>
							{label}
						</a>
					</li>
				})
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" rel={label === 'Mastodon' ? 'me' : undefined}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<a
				class="donate-link"
				href={`/${locale}/donate/`}
				aria-label={m.navDonate()}
				title={m.navDonate()}
			>
				<Icon icon="heart" />
			</a>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href, className }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class={className} href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" rel={label === 'Mastodon' ? 'me' : undefined}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class="language-picker">
				<LanguagePicker />
			</div>
			<a
				class="donate-link"
				href={`/${locale}/donate/`}
				aria-label={m.navDonate()}
				title={m.navDonate()}
			>
				<Icon icon="heart" />
			</a>
			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		line-height: 1.1;
		font-weight: 700;
		color: var(--gray-0);
		text-decoration: none;
	}

	.prompt {
		color: var(--accent-regular);
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 1px solid var(--gray-700);
		padding: 0.4rem;
		font-size: 1.25rem;
		color: var(--gray-300);
		background: var(--gray-999);
		cursor: pointer;
	}

	.menu-button[aria-expanded='true'] {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px solid var(--gray-800);
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 1.5rem;
		background-color: var(--gray-999);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
	}

	.link::before {
		content: '  ';
		white-space: pre;
	}

	.link[aria-current='page'] {
		color: var(--accent-regular);
	}

	.link[aria-current='page']::before {
		content: '> ';
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 1.5rem;
		background-color: var(--gray-999);
		border-top: 1px solid var(--gray-800);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		align-items: flex-start;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--gray-400);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-regular);
	}

	.donate-link {
		display: flex;
		align-items: center;
		padding: var(--icon-padding);
		font-size: var(--icon-size);
		color: #e5484d;
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.donate-link:hover,
	.donate-link:focus {
		color: #f2555a;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	.call-to-action {
		border: 1px solid var(--accent-regular);
		color: var(--accent-regular);
		transition:
			background-color var(--theme-transition),
			color var(--theme-transition);
	}

	.call-to-action::before {
		content: '';
	}

	.call-to-action:hover,
	.call-to-action:focus {
		background-color: var(--accent-regular);
		color: var(--accent-text-over);
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 1.25rem 2.5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-md);
		}

		.menu-content {
			display: contents;
			border: 0;
			background: none;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			gap: 0;
			font-size: var(--text-sm);
			border: 1px solid var(--gray-700);
			padding: 0;
			background: var(--gray-999);
		}

		.nav-items li + li {
			border-left: 1px solid var(--gray-800);
		}

		.link {
			display: block;
			padding: 0.5rem 1rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link::before,
		.link[aria-current='page']::before {
			content: none;
		}

		.link:hover,
		.link:focus {
			color: var(--accent-regular);
			background-color: var(--accent-subtle-overlay);
		}

		.link[aria-current='page'] {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}

		.call-to-action {
			border: 0;
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			border: 0;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}
	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>
