---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../FormattedDate.astro';
import Hero from '../Hero.astro';
import Icon from '../Icon.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	lang?: 'en' | 'pt-br';
}

const { post, lang = 'en' } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={post.data.img}
	imageAlt={post.data.img_alt}
	type="article"
	publishedTime={post.data.publishDate}
>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper stack gap-2">
					<a class="back-link" href={`/${lang}/blog/`}><Icon icon="arrow-left" /> Blog</a>
					<div class="post-meta">
						<span class="tag">{post.data.tag}</span>
						<div class="date">
							<FormattedDate date={post.data.publishDate} />
							{
								post.data.updatedDate && (
									<span class="updated">
										(updated: <FormattedDate date={post.data.updatedDate} />)
									</span>
								)
							}
						</div>
					</div>
					<Hero title={post.data.title} align="start">
						<div class="details">
							<p class="description">{post.data.description}</p>
						</div>
					</Hero>
				</div>
			</header>
			<main class="wrapper">
				<div class="stack gap-10 content">
					{post.data.img && <img src={post.data.img} alt={post.data.img_alt ?? ''} />}
					<div class="content">
						<Content />
					</div>
				</div>
			</main>
		</div>
	</div>
</BaseLayout>

<style>
	header {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: none;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.date {
		font-size: var(--text-sm);
	}

	.updated {
		color: var(--gray-400);
	}

	.tag {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-text-over);
		background: var(--accent-dark);
		border-radius: 999rem;
		padding: 0.3rem 0.85rem;
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
	}

	.description {
		font-size: var(--text-lg);
		max-width: 54ch;
	}

	.content {
		max-width: 28ch;
		margin-inline: auto;
		margin-bottom: 2rem;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--card-bg);
		border: 1px solid var(--gray-800);
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.content :global(pre) {
		background-color: var(--gray-900);
		color: var(--gray-0);
		border: 1px solid var(--gray-700);
		border-radius: 0.75rem;
		padding: 1.25rem;
		overflow-x: auto;
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.content :global(.mermaid) {
		width: 100%;
		overflow-x: auto;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background: var(--card-bg);
		box-shadow: var(--shadow-sm);
	}

	.content :global(.mermaid svg) {
		display: block;
		max-width: 100%;
		margin-inline: auto;
	}

	.content :global(code) {
		font-family: 'Fira Code', monospace;
		font-size: 0.95rem;
		line-height: 1.6;
		white-space: pre;
	}

	.back-link,
	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus,
	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}

		.details {
			flex-direction: row;
			gap: 2.5rem;
		}

		.content {
			max-width: 110ch;
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}
	}
</style>

<script>
	const highlightedBlocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"]'));
	const languageBlocks = Array.from(document.querySelectorAll('pre > code.language-mermaid'))
		.map((block) => block.closest('pre'))
		.filter((block) => block !== null);
	const mermaidBlocks = Array.from(new Set([...highlightedBlocks, ...languageBlocks]));

	if (mermaidBlocks.length > 0) {
		import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(
			({ default: mermaid }) => {
				const isDark = document.documentElement.classList.contains('theme-dark');
				mermaid.initialize({
					startOnLoad: false,
					theme: isDark ? 'dark' : 'default',
					securityLevel: 'strict',
				});

				for (const block of mermaidBlocks) {
					const container = document.createElement('div');
					container.className = 'mermaid';
					container.textContent = block.textContent ?? '';
					block.replaceWith(container);
				}

				mermaid.run({ querySelector: '.mermaid' });
			},
		);
	}
</script>
