---
import Icon from './Icon.astro';
import Window from './Window.astro';
import type { iconPaths } from './IconPaths';
import { m } from "../paraglide/messages.js";

const skills: { file: string; icon: keyof typeof iconPaths; title: string; desc: string }[] = [
	{ file: 'full-stack.md', icon: 'terminal-window', title: m.skillsFullStackTitle(), desc: m.skillsFullStackDesc() },
	{ file: 'industry.md', icon: 'trophy', title: m.skillsIndustryTitle(), desc: m.skillsIndustryDesc() },
	{ file: 'strategy.md', icon: 'strategy', title: m.skillsStrategyTitle(), desc: m.skillsStrategyDesc() },
	{ file: 'ai-first.md', icon: 'sparkle', title: m.skillsAIFirstTitle(), desc: m.skillsAIFirstDesc() },
];
---

<section class="skills">
	{
		skills.map((skill) => (
			<Window title={`~/skills/${skill.file}`}>
				<div class="skill stack gap-2">
					<Icon icon={skill.icon} color="var(--accent-regular)" size="2rem" />
					<h2>{skill.title}</h2>
					<p>{skill.desc}</p>
				</div>
			</Window>
		))
	}
</section>

<style>
	.skills {
		display: grid;
		gap: 1rem;
	}

	.skill {
		padding: 1.5rem;
	}

	.skill h2 {
		font-size: var(--text-lg);
		margin-top: 0.5rem;
	}

	.skill p {
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	@media (min-width: 50em) {
		.skills {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 75em) {
		.skills {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
