---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { m } from "../paraglide/messages.js";
import { getLocale } from "../paraglide/runtime.js";

const email = 'leandromqrs@hotmail.com';
---

<aside>
	<div class="stack gap-4">
		<h2>{m.contactTitle()}</h2>
		<p class="email">
			{m.contactEmailLabel()}
			<a href={`mailto:${email}`}>{email}</a>
		</p>
	</div>
	<div class="actions">
		<CallToAction href={`/${getLocale()}/book-a-call/`}>
			{m.contactCTABook()}
			<Icon icon="arrow-right" size="1.2em" />
		</CallToAction>
		<CallToAction
			href={`mailto:${email}?subject=Let's catch up for a cool opportunity!`}
			variant="secondary"
		>
			{m.contactCTA()}
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 4rem 1.5rem;
		background-color: var(--card-bg);
		background-image: radial-gradient(var(--gray-800) 1px, transparent 1px);
		background-size: 20px 20px;
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 24ch;
	}

	h2::before {
		content: '$ ';
		color: var(--accent-regular);
	}

	.email {
		text-align: center;
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 50em) {
		aside {
			padding: 5rem 5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}

		.email {
			text-align: left;
		}

		.actions {
			flex-direction: row;
			flex-wrap: wrap;
		}
	}
</style>
