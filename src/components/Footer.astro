---
import Icon from './Icon.astro';
import { m } from '../paraglide/messages.js';
import { getLocale } from '../paraglide/runtime.js';

const currentYear = new Date().getFullYear();
const locale = getLocale();
---

<footer>
	<div class="group">
		<p class="mode">NORMAL</p>
		<p>
			Designed & Developed with <a href="https://astro.build/">Astro</a>
			<Icon icon="rocket-launch" size="1.2em" />
		</p>
		<p>&copy; {currentYear} Leandro Rodrigues</p>
	</div>
	<p class="socials">
		<a href="https://linkedin.com/in/leandromqrs">LinkedIn</a>
		<a href="https://github.com/leandromqrs">GitHub</a>
		<a href="https://twitter.com/leandromqrs">Twitter</a>
		<a href="https://mastodon.social/@leandromqrs" rel="me">Mastodon</a>
		<a href={`/${locale}/donate/`}>{m.navDonate()}</a>
	</p>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-top: auto;
		padding: 2rem 1.5rem;
		border-top: 1px solid var(--gray-800);
		text-align: center;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	footer a {
		color: var(--gray-400);
		text-decoration: none;
	}

	footer a:hover,
	footer a:focus {
		color: var(--accent-regular);
	}

	.socials a::before {
		content: '[';
	}

	.socials a::after {
		content: ']';
	}

	.mode {
		align-self: center;
		padding: 0 0.6rem;
		font-weight: 700;
		color: var(--accent-text-over);
		background: var(--accent-regular);
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			justify-content: space-between;
			padding: 1.25rem 2.5rem;
		}

		.group {
			align-items: center;
			flex-direction: row;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.socials {
			justify-content: flex-end;
		}
	}
</style>
