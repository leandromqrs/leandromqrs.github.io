<style is:global>
	.mermaid {
		width: 100%;
		overflow-x: auto;
		border: 1px solid var(--gray-700);
		padding: 1.5rem;
		background: var(--card-bg);
	}

	.mermaid .cluster rect {
		fill: transparent !important;
		stroke: var(--gray-700) !important;
	}

	.mermaid svg {
		display: block;
		max-width: 100%;
		height: auto;
		margin-inline: auto;
	}
</style>

<script>
	const highlightedBlocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"]'));
	const languageBlocks = Array.from(document.querySelectorAll('pre > code.language-mermaid'))
		.map((block) => block.closest('pre'))
		.filter((block) => block !== null);
	const mermaidBlocks = Array.from(new Set([...highlightedBlocks, ...languageBlocks]));

	if (mermaidBlocks.length > 0) {
		import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(
			async ({ default: mermaid }) => {
				const isDark = document.documentElement.classList.contains('theme-dark');
				mermaid.initialize({
					startOnLoad: false,
					theme: isDark ? 'dark' : 'default',
					securityLevel: 'strict',
				});

				for (const [index, block] of mermaidBlocks.entries()) {
					const source = block.textContent ?? '';
					const container = document.createElement('div');
					container.className = 'mermaid';
					block.replaceWith(container);
					try {
						const { svg } = await mermaid.render(`mermaid-diagram-${index}`, source);
						container.innerHTML = svg;
					} catch (error) {
						console.error(error);
						container.textContent = source;
					}
				}
			},
		);
	}
</script>
