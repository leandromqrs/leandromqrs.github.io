---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import BlogPreview from "../../components/BlogPreview.astro";
import Grid from "../../components/Grid.astro";
import Hero from "../../components/Hero.astro";

import { m } from "../../paraglide/messages.js";

export function getStaticPaths() {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'pt-br' } }
	];
}

const lang = Astro.params.lang as 'en' | 'pt-br';
const posts = (await getCollection('blog', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title={m.blogTitle() + " | Leandro Rodrigues"}
  description={m.blogDescription()}
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero title={m.blogTitle()} tagline="" align="start" />
      {posts.length === 0 ? (
        <p class="empty">{m.blogEmpty()}</p>
      ) : (
      <Grid variant="spotlight">
        {
          posts.map((post) => (
            <li>
              <BlogPreview post={post} />
            </li>
          ))
        }
      </Grid>
      )}
    </main>
  </div>
</BaseLayout>

<style>
  .empty {
    color: var(--gray-400);
  }
</style>
