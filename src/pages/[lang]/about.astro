---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import CallToAction from "../../components/CallToAction.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import ExperienceList from "../../components/ExperienceList.astro";
import Window from "../../components/Window.astro";

// Paraglide translations
import { m } from "../../paraglide/messages.js";
import { getLocale } from "../../paraglide/runtime.js";

import { certifications, education, experience, languages, skills } from "../../data/profile";

// For dynamic routing
export function getStaticPaths() {
	return [
		{ params: { lang: 'en' } },
		{ params: { lang: 'pt-br' } }
	];
}

const locale = getLocale() as "en" | "pt-br";
const cvHref = (lang: string) => `/assets/Leandro-Rodrigues-CV-${lang}.pdf`;

const employment = experience.filter((job) => !job.contract);
const contracts = experience.filter((job) => job.contract);

const work = (await getCollection("work")).filter((entry) => entry.data.company === "QW Software").sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title={m.aboutTitle() + " | Leandro Rodrigues"}
  description={m.aboutTagline()}
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero title={m.aboutTitle()} tagline={m.aboutTagline()}>
        <div class="cv">
          <CallToAction href={cvHref(locale)} download>
            {locale === "en" ? m.aboutDownloadCvEn() : m.aboutDownloadCvPt()}
          </CallToAction>
        </div>
      </Hero>

      <section>
        <h2 class="section-title">{m.aboutBackgroundTitle()}</h2>
        <div class="content">
          <p>{m.aboutBackgroundP1()}</p>
          <p>{m.aboutBackgroundP2()}</p>
          <p>{m.aboutBackgroundP3()}</p>
          <p>{m.aboutBackgroundP4()}</p>
          <p>{m.aboutBackgroundP5()}</p>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutExperienceTitle()}</h2>
        <div class="content">
          <ExperienceList items={employment} folder="experience" locale={locale} />
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutContractsTitle()}</h2>
        <div class="content">
          <ExperienceList items={contracts} folder="contracts" locale={locale} />
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutWorkTitle()}</h2>
        <div class="content">
          <p>{m.aboutWorkIntro()}</p>
          <ul class="work-list">
            {work.map((entry) => (
              <li><a href={`/work/${entry.id}/`}>{entry.data.title}</a></li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutSkillsTitle()}</h2>
        <div class="content">
          <dl class="skills">
            {skills.map((group) => (
              <div>
                <dt>{group.name[locale]}</dt>
                <dd>{group.items.join(", ")}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutEducationTitle()}</h2>
        <div class="content">
          <ul class="plain">
            {education.map((item) => (
              <li>
                <strong>{item.title[locale]}</strong>
                <span>{item.school}, {item.period[locale]}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutCertificationsTitle()}</h2>
        <div class="content">
          <ul class="plain">
            {certifications[locale].map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutLanguagesTitle()}</h2>
        <div class="content">
          <ul class="plain">
            {languages[locale].map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-title">{m.aboutResumeTitle()}</h2>
        <div class="content">
          <Window title="~/resume/">
            <div class="resume">
              <p class="meta">{m.aboutResumeMeta()}</p>
              <p>{m.aboutResumeNote()}</p>
              <div class="downloads">
                <CallToAction href={cvHref("en")} download>{m.aboutDownloadCvEn()}</CallToAction>
                <CallToAction href={cvHref("pt-br")} variant="secondary" download>{m.aboutDownloadCvPt()}</CallToAction>
              </div>
            </div>
          </Window>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .cv {
    display: flex;
    justify-content: center;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .section-title::before {
    content: '## ';
    color: var(--accent-regular);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content > :global(* + *) {
    margin-top: 0.75rem;
  }

  .content :global(a) {
    text-underline-offset: 0.25em;
  }

  .work-list {
    margin-top: 0.75rem;
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }


  .skills {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skills dt {
    color: var(--gray-0);
    font-weight: 700;
  }

  .skills dd {
    margin: 0;
  }

  .plain {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .plain li {
    display: flex;
    flex-direction: column;
  }

  .plain strong {
    color: var(--gray-0);
  }

  .resume {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .meta {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-md);
    }
  }
</style>
